---
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("project");

if (!projects) {
  return Astro.redirect("/404");
}

const title = "Proyectos | Puriihuaman";
const description =
  "Proyectos y repositorios de Puriihuaman — desarrollo back-end con Java, Spring Boot y más.";
---

<BaseLayout title={title} description={description}>
  <section class="relative py-21 bg-night-950">
    <div class="relative z-10 max-w-300 mx-auto px-5 md:px-7 lg:px-8">
      <div class="text-left mb-12 max-w-195 md:text-center md:mx-auto md:pb-14">
        <h1
          class="text-night-50 leading-snug font-semibold text-[32px] mb-7 md:text-[42px] md:leading-[1.15] lg:text-[54px] is-visible"
        >
          Proyectos
        </h1>

        <p
          class="text-base font-light text-night-200 leading-7"
          data-animate="fade-up"
          data-delay="160"
          data-duration="800"
        >
          Cada proyecto combina diseño, automatización y tecnología para generar
          impacto real en operaciones y crecimiento.
        </p>
      </div>

      <!-- {isLoading && <Loading />} -->

      <!-- {error && <AlertMessage error={error} />} -->

      <div class="flex flex-col">
        {
          projects.map((item) => (
            <ProjectCard project={item.data}>{item.body}</ProjectCard>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  [data-animate][data-delay="120"] {
    animation-delay: 0.12s;
  }
  [data-animate][data-duration="1000"] {
    --data-animate-duration: 1s;
  }

  [data-animate="fade-up"].is-visible {
    animation-name: animate-fade-up;
    animation-duration: var(--data-animate-duration);
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: forwards;
  }

  [data-animate][data-delay="160"] {
    animation-delay: 0.16s;
  }

  [data-animate][data-duration="800"] {
    --data-animate-duration: 0.8s;
  }

  [data-animate="fade-up"].is-visible {
    animation-name: animate-fade-up;
    animation-duration: var(--data-animate-duration);
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: forwards;
  }
</style>
