---
import Avatar from "@components/Avatar.astro";
import CardEducation from "@components/CardEducation.astro";
import Hero from "@components/Hero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import Skill from "./_partial/Skill.astro";
import ProfileSummary from "./_partial/ProfileSummary.astro";

const about = await getEntry("about", "about-me");

const trainingSessions = await getCollection("education");

if (!trainingSessions) {
  return Astro.redirect("/404");
}

if (!about) {
  throw new Error("No se encontró el archivo markdown 'about-me'");
}

const { Content: ContentAbout } = await about.render();

const title = "Puriihuaman — Desarrollador Back End Java & Spring Boot";
const description =
  "Portafolio personal de Puriihuaman, desarrollador back-end especializado en Java, Spring Boot, API REST y Kafka.";
---

<BaseLayout title={title} description={description}>
  <Hero />

  <section class="relative z-10 max-w-300 mx-auto px-5 md:px-7 lg:px-8">
    <section class="py-14 space-y-8">
      <!-- about -->
      <div
        class="flex flex-col-reverse items-stretch gap-6 md:gap-8 py-4 md:py-6 md:flex-row"
      >
        <Avatar />

        <div class="space-y-8 flex-1">
          <h2 class="text-center font-bold text-2xl md:text-4xl">
            {about.data.title}
          </h2>

          <div class="about-content">
            <ContentAbout />
          </div>
        </div>
      </div>

      <!-- Training - Experience - Specialty -->
      <ProfileSummary />
    </section>

    <!-- Education -->
    <section class="py-14 space-y-8">
      <h3 class="text-center font-bold text-2xl md:text-3xl">Education</h3>

      <div class="flex flex-col gap-6">
        {
          trainingSessions.map((item) => (
            <CardEducation
              title={item.data.title}
              subtitle={item.data.organization}
              startDate={item.data.startDate}
              graduationDate={item.data.endDate}
              skills={item.data.skills}
            >
              {item.body}
            </CardEducation>
          ))
        }
      </div>
    </section>

    <Skill />
  </section>
</BaseLayout>

<style>
  .about-content {
    color: var(--color-night-200);
    font-size: var(--text-base);
    font-weight: var(--font-weight-light);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  .section__inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: 20px;
  }

  @media (min-width: 768px) {
    .section__inner {
      padding-inline: 28px;
    }
  }

  @media (min-width: 1024px) {
    .section__inner {
      padding-inline: 32px;
    }
  }
</style>
