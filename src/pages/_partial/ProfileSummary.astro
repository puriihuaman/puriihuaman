---
import { getEntry } from "astro:content";

const overview = await getEntry("profile", "overview");

if (!overview) {
  return Astro.redirect("/404");
}
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
  {
    overview.data.cards.map((item) => (
      <article class="flex-1 space-y-2 px-5 md:px-6 py-8 border border-night-700/60 rounded-xl shadow-sm bg-night-800">
        <div class="space-y-3 text-center">
          <div class="text-4xl">{item.icon}</div>
          <strong class="text-night-100">{item.title.toUpperCase()}</strong>
        </div>

        {item.items.map((item: string) => (
          <p class="text-night-300 font-light text-sm">{item}</p>
        ))}
      </article>
    ))
  }
</div>
