---
import {Icon} from "astro-icon/components";

interface Props {
  href: string;
  iconId: string;
  linkClass: SocialNetwork;
  title: string;
}

type SocialNetwork = "linkedin" | "github" | "cv" | "default";

const classes = {
  "linkedin": "border border-night-600 text-night-200 hover:border-indigo-500/40 hover:text-indigo-400 hover:bg-indigo-500/5 active:bg-night-800 active:border-night-500 focus-visible:ring-indigo-400",
  "github": "border border-night-600 text-night-200 hover:border-indigo-500/40 hover:text-indigo-400 hover:bg-indigo-500/5 active:bg-night-800 active:border-night-500 focus-visible:ring-indigo-400",
  "cv": "bg-indigo-500 text-white shadow-lg shadow-indigo-500/25 hover:bg-indigo-400 hover:shadow-indigo-400/40 hover:-translate-y-0.5 active:bg-indigo-600 active:translate-y-0 focus-visible:ring-indigo-400",
  "default": "border border-night-600 text-night-200 hover:border-indigo-500/40 hover:text-indigo-400 hover:bg-indigo-500/5 active:bg-night-800 active:border-night-500 focus-visible:ring-indigo-400"
};

const classStyle = classes[Astro.props.linkClass];

const {href, iconId, title} = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="link_ inline-flex justify-center items-center gap-2 h-10 px-5 py-2.5 whitespace-nowrap rounded-lg text-sm font-medium focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-night-950 transition-all duration-300"
  class:list={classStyle}
>
  <span class="link-title">{title}</span>
  <Icon name={iconId} class="w-4 h-4 shrink-0"/>
</a>
