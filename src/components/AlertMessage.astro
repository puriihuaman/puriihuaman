---
import {CustomError} from "@services/custom-error";

interface Props {
  error: CustomError;
}

const {error} = Astro.props;
---

<div
  class="p-4 text-center text-balance space-y-2 border text-rose-400 bg-rose-950/50 border-rose-500/20 rounded-xl shadow-sm">
  <h4>{error.name}</h4>

  <p>
    <strong class="text-xl">{error.statusCode}</strong> -&nbsp;
    {error.message}
  </p>
</div>
