---
import { getEntry } from "astro:content";

const menuEntry = await getEntry("menu", "menu");

if (!menuEntry) {
  throw new Error("No se encontró el archivo markdown 'menu'");
}

const { pathname } = Astro.url;
const getPathname = (pathname: string): string =>
  pathname.toLowerCase().trim().substring(1).replace("/", "");

const { Content } = await menuEntry.render();
---

<nav class="">
  <ul class="flex items-center gap-10">
    {
      menuEntry.data.items.map((item) => (
        <li>
          <a
            href={item.href}
            class="inline-flex justify-center items-center text-sm capitalize font-medium transition-colors duration-300"
            class:list={
              getPathname(pathname) === getPathname(item.pathname)
                ? "text-indigo-400"
                : "text-night-50 hover:text-indigo-400 active:text-indigo-400"
            }
            transition:animate="fade"
          >
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
