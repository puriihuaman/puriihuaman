---
import { Picture } from "astro:assets";

import puriihuamanPng from "@assets/images/puriihuaman.png";
---

<div class="w-full overflow-hidden rounded-2xl md:w-1/5">
  <Picture
    src={puriihuamanPng}
    formats={["webp", "png"]}
    width={125}
    height={125}
    alt="Foto Pedro Purihuaman"
    class:list={["h-full", "w-full", "object-cover", "mask-b-from-20%"]}
  />
</div>
