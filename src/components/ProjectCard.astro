---
import {Icon} from "astro-icon/components";
import {Image} from "astro:assets";
import type {Project} from "../data/project.ts";

interface Props {
  project: Project;
  reverse: boolean;
}

const formatter = (date: string) =>
  new Intl.DateTimeFormat("es-PE", {
    year: "numeric",
    month: "short",
  }).format(new Date(date));

const {
  project: {image, title, demoLink, codeLink, stack, summary},
  reverse,
} = Astro.props;
---

<article
  class="flex flex-col items-center gap-4 overflow-hidden shadow border border-night-700/60 rounded-lg md:max-w-sm"
>
  <a
    href={demoLink}
    title={title}
    class="block w-full overflow-hidden group relative md:h-48"
  >
    <Image
      src={image}
      alt={title}
      width={1200}
      height={800}
      class="w-full aspect-video object-cover block transform ease-in duration-300 group-hover:scale-[1.04]"
      loading="lazy"
    />
  </a>

  <div
    class="flex flex-col px-4 pb-4 gap-3"
  >
    <h3
      class="text-lg font-bold leading-snug capitalize text-night-50 lg:text-[26px] group"
    >
      <a
        href={demoLink}
        title={title}
        class="group-hover:text-indigo-400 transition-colors duration-300"
      >
        {title}
      </a>
    </h3>

    <div>
      <p class="text-sm">{summary}</p>
    </div>

    <ul class="flex gap-1.5 flex-wrap font-light text-xs">
      {
        stack.map((item) => (
          <li
            id={item}
            class="capitalize text-night-300 bg-night-900 text-heading px-1.5 py-0.5 rounded whitespace-nowrap"
          >
            {item}
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 text-sm text-night-400">
      <a
        href={codeLink}
        target="_blank"
        rel="noopener"
        class="bg-night-800 border border-night-800 text-night-200 inline-flex justify-center items-center gap-2 px-4 py-1.5 rounded whitespace-nowrap outline-none font-light hover:text-indigo-400 hover:shadow-indigo-400/40 transition-all duration-300"
      >
        <span class="tex-xs">GitHub</span>
        <Icon name="github" class="w-4 h-4 shrink-0"/>
      </a>
    </div>
  </div>
</article>
